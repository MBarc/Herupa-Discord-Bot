[Unit]
Description=Minecraft -> Discord log bridge (Herupa)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
EnvironmentFile=/etc/mc-bridge.env
ExecStart=/usr/bin/python3 /opt/mc-bridge/mc_bridge.py
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/opt/minecraft/server/logs

[Install]
WantedBy=multi-user.target
